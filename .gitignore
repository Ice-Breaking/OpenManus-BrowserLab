# 根级忽略规则（覆盖三个子项目）

# 运行产物
debug_html/
workspace/
logs/
outputs/
*.log

# Python 编译与缓存
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# 虚拟环境与本地环境变量
.venv/
venv/
env/
.env

# 打包产物
build/
dist/
*.egg-info/

# 前端依赖（app/tool/chart_visualization）
node_modules/

# 系统文件
.DS_Store

# 说明：各子项目的 config/config.toml 由其自带 .gitignore 忽略（上游约定），
# 本地填入真实密钥也不会被提交。
